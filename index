<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>mango arcade</title>
<meta name="description" content="Meine Spiele, alle an einem Ort.">
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<header class="top">
  <a class="logo" href="#" aria-label="Startseite">
    <span class="logo-mark" aria-hidden="true">▶</span>
    <span class="logo-text">mango<b>arcade</b></span>
  </a>

  <div class="search">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input id="q" type="search" placeholder="Spiel suchen…  (Taste /)"
           autocomplete="off" spellcheck="false" aria-label="Spiele durchsuchen">
    <button id="q-clear" class="search-clear" type="button" hidden aria-label="Suche leeren">✕</button>
  </div>

  <nav class="tabs" id="tabs" role="tablist">
    <button class="tab is-on" data-view="alle" role="tab">Alle</button>
    <button class="tab" data-view="favoriten" role="tab">★ Favoriten</button>
    <button class="tab" data-view="zuletzt" role="tab">Zuletzt</button>
  </nav>
</header>

<main>
  <section class="filters">
    <div id="tags" class="tags" aria-label="Nach Genre filtern"></div>
    <label class="sort">
      Sortieren
      <select id="sort">
        <option value="neu">Neueste zuerst</option>
        <option value="az">A – Z</option>
        <option value="gespielt">Meist gespielt</option>
      </select>
    </label>
  </section>

  <p id="count" class="count"></p>

  <section id="grid" class="grid" aria-live="polite"></section>

  <p id="empty" class="empty" hidden>
    Nichts gefunden.<br>
    <button type="button" id="reset" class="link">Filter zurücksetzen</button>
  </p>
</main>

<footer class="foot">
  <span id="foot-count"></span>
  <span class="foot-sep">·</span>
  <span>Neues Spiel dazu? <code>js/games.js</code></span>
</footer>

<!-- detailfenster -->
<div id="sheet" class="sheet" hidden role="dialog" aria-modal="true" aria-labelledby="sheet-title">
  <div class="sheet-box">
    <button id="sheet-close" class="icon-btn sheet-x" type="button" aria-label="Schließen">✕</button>
    <div id="sheet-cover" class="sheet-cover"></div>
    <div class="sheet-body">
      <h2 id="sheet-title"></h2>
      <p id="sheet-meta" class="sheet-meta"></p>
      <p id="sheet-text"></p>
      <div id="sheet-tags" class="sheet-tags"></div>
      <div class="sheet-actions">
        <button id="sheet-play" class="btn btn-main" type="button">▶ Spielen</button>
        <a id="sheet-new" class="btn" target="_blank" rel="noopener">Neuer Tab ↗</a>
        <button id="sheet-fav" class="btn btn-ghost" type="button">★ Favorit</button>
      </div>
    </div>
  </div>
</div>

<!-- spielfenster -->
<div id="player" class="player" hidden>
  <div class="player-bar">
    <span id="player-title" class="player-title"></span>
    <div class="player-btns">
      <button id="player-full" class="icon-btn" type="button" title="Vollbild">⛶</button>
      <button id="player-close" class="icon-btn" type="button" title="Schließen (Esc)">✕</button>
    </div>
  </div>
  <div class="player-frame"><iframe id="player-frame" title="Spiel" allow="autoplay; fullscreen; gamepad"></iframe></div>
</div>

<script src="js/games.js"></script>
<script src="js/app.js"></script>
</body>
</html>
